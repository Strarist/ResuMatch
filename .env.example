# === Required ===
DATABASE_URL=sqlite+aiosqlite:///./dev.db
JWT_SECRET=generate-a-strong-random-secret-min-16-chars

# === Google OAuth (optional — app works without it) ===
# Get from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8000/v1/auth/google/callback
# Authorized JS origin: http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback

# === AI Provider (optional — at least one recommended) ===
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OR for local inference:
# OLLAMA_URL=http://localhost:11434

# === Application ===
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
UPLOAD_DIR=./uploads
ENV=development

# === Observability (optional) ===
# SENTRY_DSN=
