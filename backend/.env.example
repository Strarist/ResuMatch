# Skillyn Backend Environment Variables Configuration Template
# Copy this file to .env and configure the variables.

# === Database (required) ===
# Canonical local dev: PostgreSQL + Redis via Docker (docker compose up -d postgres redis from repo root).
DATABASE_URL=postgresql+asyncpg://resumatch:resumatch_dev@localhost:5432/resumatch
# Emergency-only SQLite (not the default — requires explicit manual override):
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# === Security ===
# Secret key used for signing JWT tokens. Must be a strong, unique, 16+ character random secret.
JWT_SECRET=your-jwt-secret-minimum-16-chars

# === Redis (required for multi-worker production) ===
# Start: docker compose up -d redis (from repo root).
# If Redis is temporarily unavailable, the app degrades to in-memory cache and rate limits.
REDIS_URL=redis://localhost:6379

# Token Expiration Settings (Optional)
# JWT_ALGORITHM=HS256
# JWT_ACCESS_EXPIRE_MINUTES=10080
# JWT_REFRESH_EXPIRE_MINUTES=43200

# === OpenRouter LLM Gateway (optional in development) ===
# Leave unset to use Gemini/Ollama fallbacks via provider_factory.
# Required in production (ENV=production).
# OPENROUTER_API_KEY=sk-or-v1-your-actual-key

# Target LLM Model selection (used when OPENROUTER_API_KEY is set)
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# === Google OAuth Configuration (Optional) ===
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback

# === General App Settings ===
ENV=development
FRONTEND_URL=http://localhost:3001
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# === Observability (optional) ===
# SENTRY_DSN=
