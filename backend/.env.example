# ResuMatch Backend Environment Variables Configuration Template
# Copy this file to .env and configure the variables.

# === Database ===
# Database connection string. Use SQLite locally or PostgreSQL in production.
# SQLite example: sqlite+aiosqlite:///./dev.db
# PostgreSQL example: postgresql+asyncpg://user:pass@host:port/dbname
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# === Security ===
# Secret key used for signing JWT tokens. Must be a strong, unique, 16+ character random secret.
JWT_SECRET=your-jwt-secret-minimum-16-chars

# Token Expiration Settings (Optional)
# JWT_ALGORITHM=HS256
# JWT_ACCESS_EXPIRE_MINUTES=10080
# JWT_REFRESH_EXPIRE_MINUTES=43200

# === OpenRouter LLM Gateway ===
# OpenRouter API Key for adaptive roadmap and resume entity extraction.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Target LLM Model selection
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# === Google OAuth Configuration (Optional) ===
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback

# === General App Settings ===
ENV=development
FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=./uploads
CORS_ORIGINS=["http://localhost:3000"]
