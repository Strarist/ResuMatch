# ResuMatch Frontend Environment Variables Template
# Copy this file to .env.local and configure the variables.

# === API Connection ===
# Absolute URL pointing to the running backend FastAPI server.
# Development default: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# === Authentication (Optional) ===
# Client ID for Google Single Sign-On (SSO).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
