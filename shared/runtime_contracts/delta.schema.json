{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Delta",
  "type": "object",
  "properties": {
    "runtime_version": { "type": "string" },
    "type": { "type": "string" },
    "data": { "type": "object" },
    "metrics": { "type": "object" },
    "mutation": {
      "type": "object",
      "properties": {
        "signal": { "type": "string" },
        "delta": { "type": "string" },
        "reason": { "type": "string" },
        "confidence": { "type": "string" },
        "time": { "type": "string" }
      },
      "additionalProperties": true
    },
    "graph": {
      "$ref": "topology.schema.json"
    },
    "propagation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "impact": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "leverage": { "type": "object" },
    "orchestration": {
      "$ref": "orchestration.schema.json"
    }
  },
  "required": ["runtime_version"],
  "additionalProperties": true
}
