{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Telemetry",
  "type": "object",
  "properties": {
    "agent_id": { "type": "string" },
    "decision_type": { "type": "string" },
    "confidence": { "type": "number" },
    "payload": {
      "type": "object",
      "properties": {
        "signal": { "type": "string" },
        "details": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "required": ["agent_id", "confidence"],
  "additionalProperties": true
}
